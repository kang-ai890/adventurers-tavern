// 《冒险者酒馆》数据库 Schema（骨架版）
// 完整 50+ 表设计见设计文档；随开发阶段逐步迁移新增。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BANNED
}

enum AdminRole {
  SUPER
  OPERATOR
}

enum AnnouncementType {
  BANNER
  SYSTEM
  MAIL
}

// ---------- 账号 ----------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  username     String?    @unique
  passwordHash String?
  isGuest      Boolean    @default(true)
  deviceToken  String?    @unique
  status       UserStatus @default(ACTIVE)
  bannedUntil  DateTime?
  createdAt    DateTime   @default(now())
  lastLoginAt  DateTime?

  player Player?

  friendRequestsSent     Friend[] @relation("FriendRequester")
  friendRequestsReceived Friend[] @relation("FriendRecipient")

  @@index([status])
}

// ---------- 玩家 ----------

model Player {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  nickname        String
  avatar          String   @default("default")
  level           Int      @default(1)
  exp             Int      @default(0)
  realm           String   @default("炼气") // 境界：炼气→渡劫
  stones          Int      @default(0) // 灵石
  jades           Int      @default(0) // 仙玉
  energy          Int      @default(100) // 体力
  energyUpdatedAt DateTime @default(now())
  killScore       Int      @default(0) // 杀孽值，>0 为红名
  killScoreUpdatedAt DateTime? // 杀孽衰减结算时间（-1/小时）
  fame            Int      @default(0) // 口碑经验值
  beautyScore     Int      @default(0) // 领地美观度
  totalRevenue    Int      @default(0) // 酒馆累计营业额（决定口碑等级）
  lastCustomerGenAt DateTime? // 上次顾客到店结算时间
  breakthroughCooldownUntil DateTime? // 突破失败冷却
  breakthroughFails Int    @default(0) // 连续突破失败次数（成功清零）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  farmPlots     FarmPlot[]
  buildings     Building[]
  inventory     PlayerInventory[]
  announcements Announcement[]
  quests        Quest[]
  eventLogs     EventLog[]
  breakthroughs BreakthroughLog[]
  tavernOrders  TavernOrder[]
  gatherLogs    GatherLog[]
  attacksMade   AttackLog[]  @relation("AttackAttacker")
  attacksTaken  AttackLog[]  @relation("AttackVictim")
  checkins      CheckinLog[]
  treasures     TreasureLog[]
  heroes        Hero[]
  equipments    Equipment[]
  battles       BattleLog[]
  codexEntries  CodexEntry[]
  codexClaims   CodexClaim[]
  achievements  Achievement[]

  @@index([level])
  @@index([realm])
}

// ---------- 委托任务 ----------

model Quest {
  id           String    @id @default(uuid()) @db.Uuid
  playerId     String    @db.Uuid
  questKey     String
  progress     Int       @default(0)
  target       Int
  rewardStones Int       @default(0)
  rewardExp    Int       @default(0)
  status       String    @default("active") // active / claimed
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  claimedAt    DateTime?

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, status])
}

// ---------- 奇遇事件 ----------

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  eventId   String
  option    String   @default("A")
  result    Json?
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

// ---------- 境界突破 ----------

model BreakthroughLog {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  fromRealm String
  toRealm   String?
  success   Boolean
  cost      Json? // 花费快照（灵石/材料）
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

// ---------- 好友 ----------

model Friend {
  id          String    @id @default(uuid()) @db.Uuid
  requesterId String    @db.Uuid
  recipientId String    @db.Uuid
  status      String    @default("pending") // pending / accepted
  affinity    Int       @default(0) // 好感度
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  requester User @relation("FriendRequester", fields: [requesterId], references: [id])
  recipient User @relation("FriendRecipient", fields: [recipientId], references: [id])

  @@unique([requesterId, recipientId])
  @@index([recipientId, status])
}

// ---------- 酒馆顾客订单 ----------

model TavernOrder {
  id           String   @id @default(uuid()) @db.Uuid
  playerId     String   @db.Uuid
  customerName String
  itemId       String
  quantity     Int      @default(1)
  price        Int
  status       String   @default("pending") // pending / served / expired
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, status])
}

// ---------- 野外采集 ----------

model GatherLog {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  spotType  String   // fish / mine / herb
  itemId    String
  quantity  Int      @default(1)
  exp       Int      @default(0)
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

// ---------- 野外袭击 ----------

model AttackLog {
  id            String   @id @default(uuid()) @db.Uuid
  attackerId    String   @db.Uuid
  victimId      String   @db.Uuid
  success       Boolean
  victimWasRed  Boolean  @default(false)
  lootSnapshot  Json?
  createdAt     DateTime @default(now())

  attacker Player @relation("AttackAttacker", fields: [attackerId], references: [id])
  victim   Player @relation("AttackVictim", fields: [victimId], references: [id])

  @@index([attackerId, createdAt])
  @@index([victimId, createdAt])
}

// ---------- 每日签到 ----------

model CheckinLog {
  id           String   @id @default(uuid()) @db.Uuid
  playerId     String   @db.Uuid
  date         String // YYYY-MM-DD
  rewardStones Int      @default(0)
  rewardJades  Int      @default(0)
  createdAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, date])
}

// ---------- 寻宝罗盘 ----------

model TreasureLog {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  date       String // YYYY-MM-DD
  rewardType String
  rewardText String   @default("")
  createdAt  DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, date])
}

// ---------- 冒险者 ----------

model Hero {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  heroId    String
  star      Int      @default(1)
  level     Int      @default(1)
  exp       Int      @default(0)
  createdAt DateTime @default(now())

  player     Player      @relation(fields: [playerId], references: [id])
  equipments Equipment[]

  @@index([playerId])
}

// ---------- 装备 ----------

model Equipment {
  id        String    @id @default(uuid()) @db.Uuid
  playerId  String    @db.Uuid
  slot      String // weapon / armor / accessory
  quality   String // mortal / fine / superior / epic / immortal
  level     Int       @default(0)
  atk       Int       @default(0)
  def       Int       @default(0)
  hp        Int       @default(0)
  heroId    String?   @db.Uuid // 装备中的冒险者
  createdAt DateTime  @default(now())

  player Player @relation(fields: [playerId], references: [id])
  hero   Hero?  @relation(fields: [heroId], references: [id])

  @@index([playerId])
}

// ---------- 战斗日志 ----------

model BattleLog {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  dungeonId String
  success   Boolean
  rewards   Json?
  logText   Json?
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@index([playerId, createdAt])
}

// ---------- 图鉴 ----------

model CodexEntry {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  category  String
  itemId    String
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, category, itemId])
}

model CodexClaim {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  category  String
  pct       Float
  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, category, pct])
}

// ---------- 成就 ----------

model Achievement {
  id            String   @id @default(uuid()) @db.Uuid
  playerId      String   @db.Uuid
  achievementId String
  unlockedAt    DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, achievementId])
}

// ---------- 领地 ----------

model FarmPlot {
  id         String    @id @default(uuid()) @db.Uuid
  playerId   String    @db.Uuid
  plotIndex  Int
  cropId     String?
  plantedAt  DateTime?
  readyAt    DateTime?
  wateredBy  String[]  @default([]) // 帮忙浇水的好友 id
  waterCount Int       @default(0) // 今日被浇水次数
  waterDate  String    @default("") // 浇水计数日期（YYYY-MM-DD）

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, plotIndex])
}

model Building {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @db.Uuid
  type     String // tavern / kitchen / cellar / inn / treasure
  level    Int    @default(1)
  x        Int
  y        Int

  player Player @relation(fields: [playerId], references: [id])

  @@unique([playerId, type])
}

// ---------- 物品 ----------

model ItemDef {
  id          String @id // slug，如 "spirit_rice"
  name        String
  type        String // crop / material / dish / wine / pill / equip / pet / fashion
  rarity      String @default("common") // common/uncommon/rare/epic/legendary
  basePrice   Int    @default(0) // 灵石
  icon        String @default("default")
  description String @default("")

  inventory PlayerInventory[]
}

model PlayerInventory {
  id       String @id @default(uuid()) @db.Uuid
  playerId String @db.Uuid
  itemId   String
  quantity Int    @default(0)

  player Player  @relation(fields: [playerId], references: [id])
  item   ItemDef @relation(fields: [itemId], references: [id])

  @@unique([playerId, itemId])
}

// ---------- 配置与运营 ----------

model GameConfig {
  key         String    @id
  value       Json
  description String    @default("")
  updatedBy   String?   @db.Uuid
  updatedAt   DateTime  @updatedAt
}

model Announcement {
  id          String           @id @default(uuid()) @db.Uuid
  title       String
  content     String
  type        AnnouncementType @default(SYSTEM)
  enabled     Boolean          @default(true)
  createdBy   String?          @db.Uuid
  createdAt   DateTime         @default(now())
  publishedAt DateTime?

  player Player? @relation(fields: [createdBy], references: [id])
}

// ---------- 管理后台 ----------

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  username     String    @unique
  passwordHash String
  role         AdminRole @default(OPERATOR)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  logs AdminLog[]
}

model AdminLog {
  id         String   @id @default(uuid()) @db.Uuid
  adminId    String   @db.Uuid
  action     String // user.ban / config.update / announcement.publish ...
  targetType String   @default("")
  targetId   String   @default("")
  detail     Json?
  createdAt  DateTime @default(now())

  admin AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
}
